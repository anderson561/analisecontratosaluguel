# Copie para .env e ajuste. NUNCA versione o .env real.

# Banco de dados SQLite local (D2-bis revista, ver ADR-002) — arquivo embarcado,
# sem serviço externo a instalar/subir. Caminho relativo ao diretório de
# execução; o diretório é criado automaticamente se ainda não existir.
DATABASE_PATH=data/contract_parser.db

# OCR
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=por

# Extração híbrida (D1) — LLM opcional para cláusulas ambíguas
# Deixe vazio para operar 100% em modo local (só regras/regex).
LLM_PROVIDER=
LLM_API_KEY=

# Match de portfólio (D4)
FUZZY_MATCH_THRESHOLD=85
